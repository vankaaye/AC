---
/**
 * PricingCalculator.astro
 * ------------------------------------------------------------------
 * "Estimate your costs" — a simple self-serve cost estimator driven by
 * the Astro Care Support at Home price list (effective 1 Jul 2026).
 *
 * The visitor picks a service, a day type (weekday / Saturday /
 * Sunday & public holiday) and how much help they need; the panel
 * shows the rate, the weekly cost and a rough monthly cost.
 *
 * No funding maths, no management-fee percentages — those belong to the
 * old Home Care Package model, which Support at Home replaced. Rates
 * here must be kept in step with the published price list (and the copy
 * embedded in worker/chat-worker.js).
 *
 * Rate periods: weekday (Mon–Fri 6am–8pm), Saturday (1.3x weekday),
 * Sunday & public holiday (1.8x weekday). Values below are the
 * published per-period prices, not computed multipliers.
 * ------------------------------------------------------------------
 */

const GROUPS = [
  {
    group: 'Everyday living',
    items: [
      { label: 'General house cleaning', unit: 'hour', wk: 110, sat: 143, sun: 198 },
      { label: 'Laundry', unit: 'hour', wk: 110, sat: 143, sun: 198 },
      { label: 'Shopping assistance', unit: 'hour', wk: 110, sat: 143, sun: 198 },
      { label: 'Gardening', unit: 'hour', wk: 115, sat: 150, sun: 207 },
      { label: 'Home maintenance & repairs', unit: 'hour', wk: 118, sat: 153, sun: 212 },
      { label: 'Meal preparation', unit: 'hour', wk: 112, sat: 146, sun: 202 },
      { label: 'Meal delivery', unit: 'meal', wk: 18, sat: 23, sun: 32 },
    ],
  },
  {
    group: 'Personal care',
    items: [
      { label: 'Self-care & daily living (showering, dressing)', unit: 'hour', wk: 103, sat: 134, sun: 185 },
      { label: 'Medication assistance (non-clinical)', unit: 'hour', wk: 103, sat: 134, sun: 185 },
      { label: 'Continence management (non-clinical)', unit: 'hour', wk: 103, sat: 134, sun: 185 },
    ],
  },
  {
    group: 'Social support & community',
    items: [
      { label: 'Group social support', unit: 'hour', wk: 105, sat: 137, sun: 189 },
      { label: 'Individual social support / companionship', unit: 'hour', wk: 100, sat: 130, sun: 180 },
      { label: 'Accompanied activities & outings', unit: 'hour', wk: 100, sat: 130, sun: 180 },
      { label: 'Cultural support', unit: 'hour', wk: 100, sat: 130, sun: 180 },
      { label: 'Digital / technology help', unit: 'hour', wk: 100, sat: 130, sun: 180 },
      { label: 'Help with personal affairs (admin)', unit: 'hour', wk: 100, sat: 130, sun: 180 },
    ],
  },
  {
    group: 'Transport',
    items: [
      { label: 'Direct transport (driver & car provided)', unit: 'trip', wk: 125, sat: 163, sun: 225 },
    ],
  },
  {
    group: 'Respite',
    items: [
      { label: 'Flexible in-home respite', unit: 'hour', wk: 108, sat: 140, sun: 194 },
      { label: 'Community / centre-based respite', unit: 'hour', wk: 108, sat: 140, sun: 194 },
    ],
  },
  {
    group: 'Nursing',
    items: [
      { label: 'Registered nurse', unit: 'hour', wk: 175, sat: 228, sun: 300 },
      { label: 'Enrolled nurse', unit: 'hour', wk: 163, sat: 212, sun: 268 },
      { label: 'Nursing assistant (clinical care)', unit: 'hour', wk: 100, sat: 130, sun: 180 },
    ],
  },
  {
    group: 'Allied health',
    items: [
      { label: 'Allied health assistant', unit: 'hour', wk: 145, sat: 189, sun: 261 },
      { label: 'Podiatrist', unit: 'hour', wk: 166, sat: 216, sun: 299 },
      { label: 'Physiotherapist', unit: 'hour', wk: 199, sat: 259, sun: 358 },
      { label: 'Occupational therapist', unit: 'hour', wk: 219, sat: 285, sun: 394 },
      { label: 'Exercise physiologist', unit: 'hour', wk: 193, sat: 251, sun: 347 },
      { label: 'Dietitian / nutritionist', unit: 'hour', wk: 206, sat: 268, sun: 371 },
      { label: 'Speech pathologist', unit: 'hour', wk: 239, sat: 311, sun: 430 },
      { label: 'Social worker', unit: 'hour', wk: 194, sat: 252, sun: 349 },
      { label: 'Psychologist', unit: 'hour', wk: 271, sat: 352, sun: 488 },
      { label: 'Counsellor / psychotherapist', unit: 'hour', wk: 187, sat: 243, sun: 337 },
      { label: 'Music therapist', unit: 'hour', wk: 139, sat: 181, sun: 250 },
    ],
  },
];

const unitShort = (u) => (u === 'hour' ? 'hr' : u);
---

<div
  class="grid gap-6 rounded-3xl border hc-border p-4 sm:p-6 lg:grid-cols-2"
  style="background: var(--bg-card); border-color: var(--line); box-shadow: var(--shadow);"
>
  <!-- ============ HOW IT WORKS (spans both columns) ============ -->
  <div class="lg:col-span-2">
    <p class="rounded-2xl px-4 py-3 text-[0.95rem]" style="background: var(--euca-soft); color: var(--tx);">
      <strong>Estimate your costs:</strong> pick a service, the day it falls on and how much help you need,
      and the panel shows the rate and a rough <strong>weekly and monthly cost</strong>. Prices are GST-free
      and worker travel is already included. Nothing is sent anywhere — it's just a guide.
    </p>
  </div>

  <!-- ============ INPUTS ============ -->
  <div>
    <p class="mb-4 text-sm font-bold uppercase tracking-widest" style="color: var(--euca);">Your details</p>

    <fieldset class="mb-6">
      <legend class="readable mb-3 text-lg font-black" style="font-family: var(--font-head);">
        1. The service you need
      </legend>
      <select
        id="calcService"
        class="min-h-11 w-full rounded-xl border-2 px-3 text-[0.95rem] font-bold"
        style="border-color: var(--line); background: var(--bg);"
        aria-label="Choose a service"
      >
        {
          GROUPS.map((g) => (
            <optgroup label={g.group}>
              {g.items.map((s) => (
                <option value={s.wk} data-sat={s.sat} data-sun={s.sun} data-unit={s.unit}>
                  {s.label} — ${s.wk}/{unitShort(s.unit)}
                </option>
              ))}
            </optgroup>
          ))
        }
      </select>
    </fieldset>

    <fieldset class="mb-6">
      <legend class="readable mb-3 text-lg font-black" style="font-family: var(--font-head);">
        2. Which day?
      </legend>
      <div class="grid gap-2.5">
        {
          [
            ['wk', 'Weekday', 'Monday–Friday, 6am–8pm'],
            ['sat', 'Saturday', '1.3× the weekday rate'],
            ['sun', 'Sunday or public holiday', '1.8× the weekday rate'],
          ].map(([val, label, note], i) => (
            <label
              class="block cursor-pointer rounded-2xl border-2 px-3 py-2.5 transition-colors has-checked:border-[var(--euca)] has-checked:bg-[var(--euca-soft)]"
              style="border-color: var(--line);"
            >
              <span class="flex min-h-8 items-center gap-2.5 text-[0.95rem] font-bold">
                <input type="radio" name="calcPeriod" value={val} checked={i === 0} class="h-5.5 w-5.5 accent-[var(--euca)]" />
                <span class="flex-1">{label}</span>
              </span>
              <span class="mt-0.5 block pl-8 text-[0.82rem]" style="color: var(--tx-soft);">{note}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <fieldset>
      <legend class="readable mb-3 text-lg font-black" style="font-family: var(--font-head);">
        3. How much each week?
      </legend>
      <div class="flex items-center gap-3">
        <button id="calcLess" class="btn-primary hc-border !min-h-11 !w-11 !p-0 !text-xl" aria-label="One less">−</button>
        <output id="calcQty" class="min-w-10 text-center text-2xl font-black" style="font-family: var(--font-head);" aria-live="polite">3</output>
        <button id="calcMore" class="btn-primary hc-border !min-h-11 !w-11 !p-0 !text-xl" aria-label="One more">+</button>
        <span id="calcQtyUnit" class="text-[0.95rem] font-bold" style="color: var(--tx-soft);">hours / week</span>
      </div>
      <p class="mt-2 text-[0.9rem]" style="color: var(--tx-soft);">
        Hourly services have a 1-hour minimum per visit.
      </p>
    </fieldset>
  </div>

  <!-- ============ RESULTS ============ -->
  <div class="rounded-2xl p-5 md:p-6" style="background: var(--euca-soft);" aria-live="polite">
    <p class="mb-1 text-sm font-bold uppercase tracking-widest" style="color: var(--euca);">Your estimate</p>
    <h3 class="readable mb-4 text-lg" style="color: var(--tx-soft);">What this would cost</h3>
    <dl class="grid gap-2.5 text-[0.95rem]">
      <div class="flex items-center justify-between gap-4 border-b pb-2.5" style="border-color: var(--line);">
        <dt>💰 Rate</dt>
        <dd class="whitespace-nowrap text-xl font-black" style="color: var(--euca);" id="outRate">$110 / hr</dd>
      </div>
      <div class="flex items-center justify-between gap-4 border-b pb-2.5" style="border-color: var(--line);">
        <dt>📋 You chose</dt>
        <dd class="whitespace-nowrap text-xl font-black" id="outQty">3 hrs / week</dd>
      </div>
      <div class="flex items-center justify-between gap-4 rounded-xl px-3 py-2" style="background: var(--bg-card);">
        <dt class="font-black">✅ About each week</dt>
        <dd class="whitespace-nowrap text-2xl font-black" style="color: var(--euca);" id="outWeekly">$330</dd>
      </div>
      <div class="flex items-center justify-between gap-4 pt-1">
        <dt class="font-bold">🗓️ Roughly each month</dt>
        <dd class="whitespace-nowrap text-xl font-black" id="outMonthly">$1,430</dd>
      </div>
    </dl>
    <p class="mt-3 rounded-xl p-3 text-[0.9rem]" style="background: var(--sun-soft); color: var(--tx);">
      Most people don't pay this themselves — a <strong>Support at Home</strong> budget covers the bulk for
      eligible over-65s. <a href="#funding" style="color: var(--euca); font-weight: 700;">See how funding works</a>,
      or ask us to check what you'd actually pay.
    </p>
    <p class="mt-3 text-[0.82rem]" style="color: var(--tx-soft);">
      A friendly estimate only. Prices are GST-free with travel included; materials, ingredients, tolls and
      similar extras are charged at cost. Our rates sit at or below the IHACPA Support at Home pricing advice
      for 2026-27, and exact figures are always confirmed in writing before any care starts.
    </p>
    <a href="tel:+611800278762" class="btn-call hc-border mt-4 w-full">Talk costs with a real person</a>
  </div>
</div>

<script is:inline>
  (function () {
    var qty = 3;
    var $ = function (id) { return document.getElementById(id); };
    function dollars(n) { return '$' + Math.round(n).toLocaleString('en-AU'); }

    function selectedOption() {
      var sel = $('calcService');
      return sel.options[sel.selectedIndex];
    }
    function period() {
      var c = document.querySelector('input[name="calcPeriod"]:checked');
      return c ? c.value : 'wk';
    }
    function unitWord(unit, plural) {
      if (unit === 'hour') return plural ? 'hours' : 'hour';
      if (unit === 'meal') return plural ? 'meals' : 'meal';
      if (unit === 'trip') return plural ? 'trips' : 'trip';
      return unit;
    }
    function unitShort(unit) { return unit === 'hour' ? 'hr' : unit; }

    function recalc() {
      var opt = selectedOption();
      var unit = opt.getAttribute('data-unit') || 'hour';
      var p = period();
      var rate = p === 'sat'
        ? Number(opt.getAttribute('data-sat'))
        : p === 'sun'
          ? Number(opt.getAttribute('data-sun'))
          : Number(opt.value);

      var weekly = rate * qty;
      var monthly = weekly * (52 / 12);

      $('outRate').textContent = dollars(rate) + ' / ' + unitShort(unit);
      $('calcQty').textContent = String(qty);
      $('calcQtyUnit').textContent = unitWord(unit, true) + ' / week';
      $('outQty').textContent = qty + ' ' + unitWord(unit, qty !== 1) + ' / week';
      $('outWeekly').textContent = dollars(weekly);
      $('outMonthly').textContent = dollars(monthly);
    }

    $('calcService').addEventListener('change', recalc);
    document.querySelectorAll('input[name="calcPeriod"]').forEach(function (r) {
      r.addEventListener('change', recalc);
    });
    $('calcMore').addEventListener('click', function () { if (qty < 40) { qty++; recalc(); } });
    $('calcLess').addEventListener('click', function () { if (qty > 1) { qty--; recalc(); } });

    recalc();
  })();
</script>
